# Copy to .env and fill in. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env

# ---- App -------------------------------------------------------------------
# local | test | production   (production forces NEWS_LIVE_FALLBACK off)
APP_ENV=local
LOG_LEVEL=INFO
# JSON list of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:3000"]
# Per-dependency timeout for /ready, seconds.
READINESS_TIMEOUT_S=3
# Public-demo protection: agent runs/resumes per client IP per minute, max question length.
API_RUNS_PER_MINUTE=6
API_MAX_QUESTION_CHARS=1000

# ---- Postgres --------------------------------------------------------------
POSTGRES_USER=fira
POSTGRES_PASSWORD=fira
POSTGRES_DB=fira
# Host port for the compose Postgres (5442: 5432/5433 are taken by native Postgres installs).
POSTGRES_HOST_PORT=5442
# Used when running Python on the host. docker-compose overrides it for the api container.
DATABASE_URL=postgresql+psycopg://fira:fira@localhost:5442/fira

# ---- Weaviate --------------------------------------------------------------
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8095
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50055
# Host ports compose publishes Weaviate on (keep in sync with the two ports above).
WEAVIATE_HOST_HTTP_PORT=8095
WEAVIATE_HOST_GRPC_PORT=50055
# Only needed for Weaviate Cloud.
WEAVIATE_API_KEY=

# ---- Groq (required: /ready fails without the key) -------------------------
GROQ_API_KEY=
# Model ids come from Groq's live model list (GET https://api.groq.com/openai/v1/models).
# Verified 2026-11-04: openai/gpt-oss-120b (reasoning) and openai/gpt-oss-20b (fast).
GROQ_MODEL_REASONING=
GROQ_MODEL_FAST=
# Agent + dev testing models. Use a different model than ingestion: Groq limits are per
# model per organization, so this keeps the agent off the ingestion model's daily quota.
AGENT_MODEL_REASONING=
AGENT_MODEL_FAST=
# Account limits per model (free-tier values). Used for pacing and run projections.
GROQ_TOKENS_PER_MINUTE=8000
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_DAY=200000
GROQ_REQUESTS_PER_DAY=1000
# Ingestion stops cleanly at this many counted tokens per model per rolling 24h.
GROQ_DAILY_TOKEN_BUDGET=170000
# USD per 1M tokens [input, output], from console.groq.com/docs/model/<id> (checked 2026-11-04).
GROQ_PRICES_USD_PER_MTOK={"openai/gpt-oss-20b":[0.075,0.30],"openai/gpt-oss-120b":[0.15,0.60]}

# ---- Data sources (needed from Phase 1) ------------------------------------
# SEC requires "Name email" in the User-Agent of every request.
SEC_USER_AGENT=Dev Mittal devmittal2607@gmail.com
NEWSAPI_KEY=
# Call NewsAPI live when stored news is stale. Ignored (off) when APP_ENV=production.
NEWS_LIVE_FALLBACK=true
# NewsAPI free plan allows 100 requests/day; ingestion stops at this many.
NEWSAPI_REQUESTS_PER_DAY=90

# ---- Frontend --------------------------------------------------------------
# API base URL as seen from the browser (baked into the web image at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
